{
  "name": "vox-quietus-backend",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "build": "esbuild src/server.ts --bundle --platform=node --target=node24 --format=cjs --sourcemap --outfile=dist/server.js --external:bufferutil --external:utf-8-validate",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/itty-router-extras": "^0.4.3",
    "@types/jest": "^29.5.8",
    "@types/node": "^24.19.1",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "ts-jest": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "^4.5.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/client-sesv2": "^3.1146.0",
    "@whatwg-node/server": "^0.13.0",
    "@zxcvbn-ts/core": "^3.0.4",
    "itty-router": "^5.0.18",
    "itty-router-extras": "^0.4.6",
    "uuid": "^9.0.1",
    "ws": "^8.22.0"
  }
}
